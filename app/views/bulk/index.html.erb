<head>
    <%= stylesheet_link_tag "bulk" %>
</head>
<body>

<h1>Bulk</h1>
<%= form_with url: "/search", method: :get, local: true do |form| %>
  <%= form.label :query, "Search for:" %>
  <%= form.search_field :query, value: params[:query], placeholder: "Type keywords..."  %>
  <%= form.submit "Search" %>
<% end %>
<table border=1 frame=asides rules=rows>
<tr>
    <th>
        Card ID
    </th>
    <th>
        Name
    </th>
    <th>
        Location
    </th>
    <th>
        Sleeved
    </th>
    
</tr>
  <% @bulk_controller.each do |card| %>
  <tr>
    <td>
      <%= card.card_id %>
    </td>
    <td>
      <%= card.card_information.card_name %>
    </td>
    <td>
        <%= card.location%> 
    </td>
    <td>
        <%= card.sleeved%>
    </td>
    </tr>
  <% end %>

</table>
<ul>
  <% @cards.each do |card| %>
    <li>
      <%= card.card_name %>
    </li>
  <% end %>
</ul>
</body>