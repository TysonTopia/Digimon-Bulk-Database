<h1>New Addition</h1>

<%= form_with model: @bulk_controller do |card| %>
  <div>
    <%= card.label :card_id %><br>
    <%= card.text_field :card_id %>
    <% @bulk_controller.errors.full_messages_for(:card_id).each do |message| %>
      <div><%= message %></div>
      <% end %>
  </div>

  <div>
    <%= card.label :location %><br>
    <%= card.text_area :location %>
    <% @bulk_controller.errors.full_messages_for(:location).each do |message| %>
      <div><%= message %></div>
      <% end %>
  </div>

    <div>
    <%= card.label :sleeved %><br>
    <%= card.text_area :sleeved %>
    <% @bulk_controller.errors.full_messages_for(:sleeved).each do |message| %>
      <div><%= message %></div>
      <% end %>
  </div>

  <div>
    <%= card.submit %>
  </div>
<% end %>
